# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# .next JEST commitowany (patrz niżej) — wysyłamy zbudowaną wersję przez
# git, bo hosting nie radzi sobie z budowaniem na serwerze. Ignorujemy
# tylko cache builda, bo jest duży i niepotrzebny do uruchomienia appki.
/.next/cache/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wygenerowany klient Prisma JEST commitowany (patrz niżej) — zawiera silniki
# dla kilku platform (binaryTargets w schema.prisma), więc serwer nie musi
# sam odpalać `prisma generate`.

# lokalnie wgrywane zdjęcia produktów (poza repo w produkcji, patrz UPLOADS_DIR)
/.uploads
